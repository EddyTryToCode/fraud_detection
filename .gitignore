# ==============================================================================
# .gitignore: Standard Configuration for Python, ML, FastAPI & Docker Project
# ==============================================================================

# --- Secrets, API Keys & Environment Variables ---
.env
*.env
.env.*
!.env.example
kaggle.json
*kaggle.json

# --- Large Datasets (Do NOT push GBs of data to GitHub) ---
data/raw/*.csv
data/raw/*.zip
data/raw/*.tar.gz
data/processed/*.parquet
data/processed/*.csv

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
conda-env/
bin/
lib/
include/

# --- Python & Bytecode Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Jupyter Notebooks Checkpoints ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Testing & Quality Tools ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- IDE & OS Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# --- Logs & Scratch Directories ---
*.log
scratch/
.system_generated/
