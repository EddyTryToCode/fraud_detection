# Example Environment Configuration for Banking Fraud Detection System
# Copy this file to .env and fill in your API keys:
# cp .env.example .env

# Optional: OpenAI API Key for Natural Language Compliance Reporting
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Google Gemini API Key (Alternative LLM provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=8000
